{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clankr-intelligence-website",
  "compatibility_date": "2026-07-27",
  "preview_urls": true,
  "routes": [
    {
      "pattern": "clankrintelligence.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
